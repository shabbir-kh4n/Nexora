# Copy to infrastructure/.env (never committed) and fill in the blanks.
# Names only: no real values are stored in the repository.
# Give each service only the variables listed under its own heading; do not load this whole file into every service.
# Never prefix a secret with VITE_: Vite embeds VITE_ variables in the browser bundle.

# --- Docker Compose (PostgreSQL and Redis, used by the Java backend only) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
NEXORA_POSTGRES_HOST_PORT=5433
NEXORA_REDIS_HOST_PORT=6379

# --- Java backend (public API) ---
NEXORA_BACKEND_HOST=127.0.0.1
NEXORA_BACKEND_PORT=8080
# Internal Java -> Python base URL (never exposed to the browser)
NEXORA_AI_SERVICE_URL=http://127.0.0.1:8000

# --- Python AI service (internal only) ---
NEXORA_AI_SERVICE_HOST=127.0.0.1
NEXORA_AI_SERVICE_PORT=8000
# S1 fake agent: pause between scripted events, and the idle heartbeat interval (seconds)
NEXORA_FAKE_EVENT_DELAY_SECONDS=1.0
NEXORA_HEARTBEAT_INTERVAL_SECONDS=15

# --- Java and Python only: internal shared secret ---
NEXORA_INTERNAL_SHARED_SECRET=
